{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "createdAt", "node", "consumer", "criterion", "source", "head", "attempts", "files"],
  "properties": {
    "schemaVersion": {"const": "observation-consumer/retention/v1"},
    "createdAt": {"type": "string", "minLength": 20, "maxLength": 30},
    "node": {"const": "24.15.0"},
    "consumer": {"$ref": "#/$defs/component"},
    "criterion": {"$ref": "#/$defs/component"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["bundleSha256", "mappingSha256"],
      "properties": {"bundleSha256": {"$ref": "#/$defs/sha"}, "mappingSha256": {"$ref": "#/$defs/sha"}}
    },
    "head": {"$ref": "#/$defs/id"},
    "attempts": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["requestId", "requestSha256", "assessmentSha256", "retryOf"],
        "properties": {
          "requestId": {"$ref": "#/$defs/id"},
          "requestSha256": {"$ref": "#/$defs/sha"},
          "assessmentSha256": {"$ref": "#/$defs/sha"},
          "retryOf": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
        }
      }
    },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 2000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
          "sha256": {"$ref": "#/$defs/sha"}
        }
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"const": "0.1.0"}, "sha256": {"$ref": "#/$defs/sha"}}
    }
  }
}
