{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trial-runner.invalid/contracts/integration/v1",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "repository",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "area": {
          "enum": [
            "entrypoint",
            "runtime",
            "hooks",
            "state",
            "lifecycle",
            "dependencies"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "certainty": {
          "enum": [
            "observed",
            "inferred"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "minItems": 1,
          "maxItems": 128
        }
      },
      "required": [
        "id",
        "area",
        "claim",
        "certainty",
        "evidence"
      ],
      "additionalProperties": false
    },
    "unknown": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "area": {
          "enum": [
            "entrypoint",
            "runtime",
            "hooks",
            "state",
            "lifecycle",
            "dependencies"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "resolution": {
          "enum": [
            "source",
            "owner"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "recommendation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "area",
        "question",
        "resolution",
        "blocking",
        "recommendation"
      ],
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "trial-runner/integration-discovery/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "location": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "revision": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "location",
              "revision"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 16
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1,
          "maxItems": 128
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unknown"
          },
          "minItems": 0,
          "maxItems": 128
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "scope",
        "repositories",
        "sources",
        "facts",
        "unknowns"
      ],
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "agent-loop",
            "tool-routing",
            "model-capture",
            "fresh-state",
            "independent-readback",
            "cancellation",
            "cleanup",
            "dependency-closure"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "supported",
            "gap",
            "not_applicable"
          ]
        },
        "mechanism": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "factIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "name",
        "required",
        "state",
        "mechanism",
        "factIds",
        "limitations"
      ],
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "trial-runner/integration-contract/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "discovery": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "entrypointFactId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "questionId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "basis": {
                "enum": [
                  "user",
                  "existing_scope"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              }
            },
            "required": [
              "questionId",
              "answer",
              "basis",
              "reference"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 128
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          },
          "minItems": 8,
          "maxItems": 8
        },
        "fidelity": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "mode": {
                "enum": [
                  "real",
                  "substituted",
                  "unobserved"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              }
            },
            "required": [
              "component",
              "mode",
              "description"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 64
        },
        "bounds": {
          "type": "object",
          "properties": {
            "maxBuildAttempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "maxTrialRuns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "maxWallTimeMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 43200000
            },
            "provider": {
              "enum": [
                "none",
                "existing_allowance"
              ]
            },
            "allowanceRef": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "maxBuildAttempts",
            "maxTrialRuns",
            "maxWallTimeMs",
            "provider",
            "allowanceRef"
          ],
          "additionalProperties": false
        },
        "qualification": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "capability": {
                "enum": [
                  "agent-loop",
                  "tool-routing",
                  "model-capture",
                  "fresh-state",
                  "independent-readback",
                  "cancellation",
                  "cleanup",
                  "dependency-closure"
                ]
              },
              "procedure": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "expected": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              }
            },
            "required": [
              "id",
              "capability",
              "procedure",
              "expected"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 64
        },
        "handoff": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "enum": [
                  "build",
                  "run",
                  "inspect",
                  "verify",
                  "rebuild",
                  "cleanup"
                ]
              },
              "command": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              }
            },
            "required": [
              "action",
              "command",
              "notes"
            ],
            "additionalProperties": false
          },
          "minItems": 6,
          "maxItems": 6
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "discovery",
        "scope",
        "entrypointFactId",
        "decisions",
        "capabilities",
        "fidelity",
        "bounds",
        "qualification",
        "handoff"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/discovery"
    },
    {
      "$ref": "#/$defs/contract"
    }
  ]
}
