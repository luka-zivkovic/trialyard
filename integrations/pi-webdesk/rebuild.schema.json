{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "state": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "trial-runner/pi-build-state/v1"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777216
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "content": {
                "type": "string",
                "maxLength": 2097152
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256",
              "content"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 128
        },
        "fixedInputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "root": {
                "enum": [
                  "webdesk",
                  "runner"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "root",
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 2048
        },
        "compiler": {
          "type": "object",
          "properties": {
            "nodeSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "entrySha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "binarySha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "nodeSha256",
            "entrySha256",
            "binarySha256"
          ],
          "additionalProperties": false
        },
        "tooling": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 32
        },
        "runtimeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "graphSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "sources",
        "fixedInputs",
        "compiler",
        "tooling",
        "runtimeSha256",
        "graphSha256"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "trial-runner/pi-source-selection/v1"
        },
        "parentRecipeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777216
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "content": {
                "type": "string",
                "maxLength": 2097152
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256",
              "content"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 128
        },
        "execution": {
          "const": "not_run"
        }
      },
      "required": [
        "schemaVersion",
        "parentRecipeSha256",
        "sources",
        "execution"
      ],
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "trial-runner/pi-rebuild/v1"
        },
        "parentRecipeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parentStateSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parentInputSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "before": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "after": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "before",
              "after"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 128
        },
        "preservedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777216
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 512
        },
        "execution": {
          "const": "not_run"
        }
      },
      "required": [
        "schemaVersion",
        "parentRecipeSha256",
        "parentStateSha256",
        "parentInputSha256",
        "inputSha256",
        "sourceChanges",
        "preservedFiles",
        "execution"
      ],
      "additionalProperties": false
    }
  }
}
